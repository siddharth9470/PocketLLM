# Copy this file to .env.local and fill in your values.
# Expo loads .env.local automatically; .env.example is NOT loaded at runtime.
#
#   cp .env.example .env.local
#
# Public DSN used at runtime to send crash reports and logs to Sentry.
EXPO_PUBLIC_SENTRY_DSN=https://<key>@o<orgId>.ingest.sentry.io/<projectId>

# Used during native release builds to upload source maps (do not commit real values).
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug
SENTRY_AUTH_TOKEN=your-sentry-auth-token
